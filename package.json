{
  "name": "blank",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "extension:build": "tsc -p extension && vite build --config extension/vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "mayhem:web": "tsc --noEmit && vite build --config vite.mayhem.config.ts",
    "mayhem:dev": "tauri dev --config src-tauri/tauri.mayhem.conf.json",
    "mayhem:build": "tauri build --no-bundle --config src-tauri/tauri.mayhem.conf.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "lucide-react": "^0.468.0",
    "motion": "13.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
