{
  "manifest_version": 3,
  "name": "blank. Zusammen schauen",
  "short_name": "blank.",
  "description": "Twitch zusammen schauen: Wechselst du den Kanal, wechseln alle im Raum mit. Gleiche Räume wie in blank.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "blank. Zusammen schauen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.twitch.tv/*", "https://twitch.tv/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src wss://broker.hivemq.com:8884 wss://test.mosquitto.org:8081"
  }
}
