{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blank. Mayhem Collector",
  "version": "0.1.0",
  "identifier": "com.blank.mayhemcollector",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "blank. Collector", "width": 360, "height": 465, "minWidth": 320, "minHeight": 440, "maximizable": false, "visible": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
