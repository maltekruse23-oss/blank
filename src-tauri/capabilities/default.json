{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Own title bar may drag, minimize and close the window; Twitch, autostart (own Run entry), usage, PC status (incl. closing a program named in a warning), pet-mode window, read-only device battery commands and opening soundcloud.com links and writing the settings export to Downloads run in Rust; RAM cleaning asks Windows for administrator rights each time. No filesystem, shell, HTTP, or hardware permissions for the frontend.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-usage",
    "allow-autostart-enabled",
    "allow-clean-memory",
    "allow-close-program",
    "allow-device-batteries",
    "allow-set-autostart",
    "allow-pc-status",
    "allow-pet-resize",
    "allow-play-alert-sound",
    "allow-program-running",
    "allow-set-pet-mode",
    "allow-settings-export",
    "allow-soundcloud-open",
    "allow-twitch-account",
    "allow-twitch-eventsub-status",
    "allow-twitch-set-client-id",
    "allow-twitch-start-login",
    "allow-twitch-finish-login",
    "allow-twitch-cancel-login",
    "allow-twitch-logout",
    "allow-twitch-open-channel",
    "allow-twitch-load-watchlist",
    "allow-twitch-save-watchlist",
    "allow-twitch-find-channel",
    "allow-twitch-channels",
    "allow-twitch-search-categories",
    "allow-twitch-live-streams"
  ]
}
